 --color-primary: #538ec8;\n  --color-secondary: #ffcb03;\n  --color-tertiary: #ff585f;\n  --color-primary-darker: #335e89;\n  --color-secondary-darker: #ffbb00;\n  --color-tertiary-darker: #fd424b;\n  --color-primary-opacity: #5ec5763a;\n  --color-secondary-opacity: #ffcd0331;\n  --color-tertiary-opacity: #ff58602d;\n  --gradient-primary: linear-gradient(to top left, #44abcb, #2b6acf);\n  --gradient-secondary: linear-gradient(to top left, #ffb003, #ffcb03);\n}\n\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: inherit;\n}\n\nhtml {\n  font-size: 62.5%;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: \"Poppins\", sans-serif;\n  font-weight: 300;\n  color: #444;\n  line-height: 1.9;\n  background-color: #f3f3f3;\n}\n\n.section__description {\n  font-size: 1.8rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  color: var(--color-primary);\n  margin-bottom: 1rem;\n}\n\n.section__header {\n  font-size: 4rem;\n  line-height: 1.3;\n  font-weight: 500;\n}\n\n.btn {\n  display: inline-block;\n  background-color: var(--color-primary);\n  font-size: 1.6rem;\n  font-family: inherit;\n  font-weight: 500;\n  border: none;\n  padding: 1.25rem 4.5rem;\n  border-radius: 10rem;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n\n.btn:hover {\n  background-color: var(--color-primary-darker);\n}\n\n.btn--text {\n  display: inline-block;\n  background: none;\n  font-size: 1.7rem;\n  font-family: inherit;\n  font-weight: 500;\n  color: var(--color-primary);\n  border: none;\n  border-bottom: 1px solid currentColor;\n  padding-bottom: 2px;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n\np {\n  color: #666;\n}\n\n/* NAVIGATION */\n.nav {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-left: 5rem;\n  padding-right: 5rem;\n  height: 10rem;\n  width: 100%;\n  z-index: 100;\n}\n\n.nav.sticky {\n  position: fixed;\n  background-color: rgba(255, 255, 255, 0.95);\n}\n\n.nav__logo {\n  height: 15rem;\n  transition: all 0.3s;\n}\n\n.nav__links {\n  display: flex;\n  align-items: center;\n  list-style: none;\n}\n\n.nav__item {\n  margin-left: 4rem;\n}\n\n.nav__link:link,\n.nav__link:visited {\n  font-size: 1.7rem;\n  font-weight: 400;\n  color: inherit;\n  text-decoration: none;\n  display: block;\n  transition: all 0.3s;\n}\n\n.nav__link--btn:link,\n.nav__link--btn:visited {\n  padding: 0.8rem 2.5rem;\n  border-radius: 3rem;\n  background-color: var(--color-primary);\n  color: #222;\n}\n\n.nav__link--btn:hover,\n.nav__link--btn:active {\n  color: inherit;\n  background-color: var(--color-primary-darker);\n  color: #333;\n}\n\n.header {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.header__title {\n  font-size: 2.5rem;\n  text-align: center;\n  margin-top: 10rem;\n}\n\n.header__location {\n  font-size: 3rem;\n  text-align: left;\n  margin-top: 4rem;\n}\n\n.highlight {\n  position: relative;\n}\n\n.highlight::after {\n  display: block;\n  content: \"\";\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  height: 100%;\n  width: 100%;\n  z-index: -1;\n  opacity: 0.7;\n  border: 1px solid #ccc;\n  transform: scale(1.07, 1.05) skewX(8deg);\n  background-image: var(--gradient-primary);\n}\n\n.header__img {\n  width: 100%;\n  grid-column: 2 / 3;\n  grid-row: 1 / span 4;\n  transform: translateY(-6rem);\n}\n.section--sign-up {\n  background-color: #37383d;\n  border-top: none;\n  border-bottom: 1px solid #444;\n  text-align: center;\n  padding: 10rem 3rem;\n}\n.performer_image {\n  width: 50rem;\n  height: 40rem;\n  align-self: center;\n}\n.results {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  margin-top: 5rem;\n}\n\n/*COLUMNS*/\n.performance_row {\n  display: flex;\n  align-self: center;\n  /*align contents to center*/\n  justify-content: center;\n  padding: 5rem;\n}\n\n.performance_column {\n  flex: 50%; /* Equal width for each column */\n  text-align: center;\n  background-color: #ffffff;\n  height: 500px;\n  margin: 1rem;\n  position: relative;\n  box-shadow: 0 2rem 5rem 1rem rgba(0, 0, 0, 0.1);\n  border-radius: 30px;\n}\n\n.performance_info_row {\n  background-color: #ffffff;\n  height: 30%;\n  position: absolute;\n  bottom: 0;\n  width: 100%;\n  border-radius: 30px;\n}\n.performer_img {\n  width: 350px;\n  border-radius: 30px;\n}\n.performance_title {\n  font-size: 25px;\n  font-weight: bold;\n}\n\n.section--sign-up .section__header {\n  color: #fff;\n  text-align: center;\n}\n\n.section--sign-up .section__title {\n  margin-bottom: 6rem;\n}\n\n.section--sign-up .btn {\n  font-size: 1.9rem;\n  padding: 2rem 5rem;\n}\n\n/* FOOTER */\n.footer {\n  padding: 10rem 3rem;\n  background-color: #37383d;\n  height: 45rem;\n}\n\n.footer__nav {\n  list-style: none;\n  display: flex;\n  justify-content: center;\n}\n\n.footer__item {\n  margin-right: 4rem;\n}\n\n.footer__link {\n  font-size: 1.6rem;\n  color: #eee;\n  text-decoration: none;\n  align-items: center;\n}\n\n.footer__logo {\n  height: 12rem;\n  display: block;\n  margin: 0 auto;\n  margin-bottom: 5rem;\n  align-self: center;\n  margin-top: 15rem;\n}\n\n.footer__copyright {\n  font-size: 1.4rem;\n  color: #aaa;\n  text-align: center;\n}\n\n.footer__copyright .footer__link {\n  font-size: 1.4rem;\n}\n\n.hidden {\n  visibility: hidden;\n  opacity: 0;\n}\n"},"lineCount":301}},"error":null,"hash":"903e40140984f2ee09d552ef0e8be8f0","cacheData":{"env":{}}}